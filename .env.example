# Copy this file to ".env" for local development. Never commit the real ".env" file.

# Django
DJANGO_SECRET_KEY=change-this-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Leave DB_ENGINE unset (or anything other than "postgres") to use local SQLite.
# Set DB_ENGINE=postgres and fill in the values below to use DigitalOcean Managed Postgres.
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=25060
